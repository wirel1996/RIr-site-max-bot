# MAX bot
MAX_ENABLED=1
MAX_BOT_TOKEN=your_max_bot_token_here

# MAX inbound settings
MAX_INBOUND_ENABLED=1
MAX_POLL_INTERVAL=3
MAX_WEBHOOK_ENABLED=0
MAX_WEBHOOK_PORT=8080
MAX_WEBHOOK_PATH=/max/webhook

# Logging
MAX_DEBUG=0
MAX_LOG_PATH=./log/max.log
MAX_LOG_IDENTITY=1
MAX_PROCESSED_TTL_SECONDS=600

# ARSHIN settings
ARSHIN_ENABLED=1
ARSHIN_API_BASE_URL=https://fgis.gost.ru/fundmetrology/eapi/vri
ARSHIN_TIMEOUT_SECONDS=15
ARSHIN_RESULT_LIMIT=5
ARSHIN_TYPE_API_KEYS=mit_notation
ARSHIN_MER_ORG_TITLE=ООО "МЭР"
# Список поверителей для кнопок (через |). Если не задано — берутся МЭР + АРТЕБ-РЕСУРС.
# ARSHIN_ORG_TITLES=ООО "МЭР"|ООО "АРТЕБ-РЕСУРС"
ARSHIN_ALLOWED_YEARS=2026,2025,2024,2023,2022,2021

# ARSHIN debug log (0/1)
ARSHIN_DEBUG=0
ARSHIN_LOG_PATH=./log/arshin.log

# Yandex Disk photo upload
YANDEX_DISK_TOKEN=your_yandex_oauth_token_here
YANDEX_DISK_BASE_PATH=Фото узлов/Фото
YANDEX_DISK_CACHE_TTL=600
YANDEX_DISK_MAX_DEPTH=4

# PDF с данными поверки (Prawn). Шрифт должен поддерживать кириллицу.
# По умолчанию служба автоподбирает Arial/Calibri на Windows и DejaVu Sans на Linux.
# PDF_FONT_PATH=C:\Windows\Fonts\arial.ttf
# PDF_FONT_BOLD_PATH=C:\Windows\Fonts\arialbd.ttf
PENDING_SNAPSHOTS_TTL=3600

# Google Sheets (tasks)
SHEETS_ENABLED=1
SHEETS_DOCUMENT_ID=your_google_sheet_id_here
SHEETS_REFRESH_WORK_MINUTES=15
SHEETS_REFRESH_OFFHOUR_MINUTES=60
SHEETS_WORK_HOUR_FROM=8
SHEETS_WORK_HOUR_TO=17
SHEETS_TZ_OFFSET=+07:00

# Contacts (Google Sheets, read-only sync to SQLite)
CONTACTS_DOCUMENT_ID=your_contacts_sheet_id_here
CONTACTS_DB_PATH=./storage/contacts.db
CONTACTS_SYNC_CRON=15 8 * * 1-5

# Contacts web UI (Sinatra)
CONTACTS_WEB_BIND=0.0.0.0
CONTACTS_WEB_PORT=4567
CONTACTS_WEB_PASSWORD=your_password_here

# ГВС Billing (Google Sheets — read/write)
BILLING_ENABLED=0
BILLING_DOCUMENT_ID=your_billing_sheet_id_here
BILLING_ALLOWED_USER_IDS=
BILLING_MONTH_CREATOR_IDS=
BILLING_POVERKI_HORIZON_DAYS=30
BILLING_NEW_MONTH_REMINDER_CRON=0 9 1 * *

# Google OAuth
GOOGLE_OAUTH_CLIENT_ID=your_google_oauth_client_id
GOOGLE_OAUTH_CLIENT_SECRET=your_google_oauth_client_secret
GOOGLE_OAUTH_REFRESH_TOKEN=your_google_oauth_refresh_token
