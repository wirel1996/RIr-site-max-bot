{
	# Let's Encrypt (ACME): автопродление TLS. Порт 80 занят IIS — только TLS-ALPN на :443.
	email riryvedomleniya@yandex.ru
	auto_https disable_redirects
	storage file_system C:/max_bot/caddy/data

	# Служебные логи Caddy (TLS, прокси, ошибки) — файл с ротацией.
	log default {
		output file C:/max_bot/log/caddy.log {
			roll_size 5mb
			roll_keep 3
		}
		level WARN
		exclude http.log.access
	}
}

северскокэ.рф:443, www.северскокэ.рф:443 {
	encode zstd gzip

	tls {
		issuer acme {
			disable_http_challenge
		}
	}

	# Шум: keepalive сессии, статика — не пишем в access-лог.
	@log_skip_ping path /api/auth/ping /api/journal/week-status /favicon.ico /manifest.json /robots.txt
	@log_skip_static path_regexp \.(js|css|ico|png|jpe?g|gif|svg|woff2?|ttf|map)$

	log_skip @log_skip_ping
	log_skip @log_skip_static

	log {
		output file C:/max_bot/log/caddy_access.log {
			roll_size 10mb
			roll_keep 3
		}
		format filter {
			wrap json
			fields {
				request>headers delete
				resp_headers delete
				tls delete
			}
		}
	}

	@api path /api/*
	handle @api {
		reverse_proxy 127.0.0.1:4567 {
			header_up X-Real-IP {remote_host}
		}
	}

	handle {
		root * C:/max_bot/web-frontend/dist
		try_files {path} /index.html
		file_server
	}
}
